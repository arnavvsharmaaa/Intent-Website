---
// Shared shell for the legal pages (/privacy/, /terms/): same header, footer,
// type scale and colours as the rest of the site, set as a readable document.
import BaseLayout from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ArrowLeft, ArrowUpRight, ChevronDown } from 'lucide-astro';
import '../styles/legal.css';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** ISO date (YYYY-MM-DD) the document takes effect. */
  effective: string;
  sections: { id: string; label: string }[];
}

const { title, description, heading, effective, sections } = Astro.props;
const effectiveLabel = new Date(`${effective}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main id="main" class="legal-page">
    <div class="legal-container">
      <a class="legal-back" href="/"><ArrowLeft size={15}/> Back to Intent</a>
      <nav class="legal-tabs" aria-label="Legal documents">
        <a href="/privacy/" aria-current={Astro.url.pathname.startsWith('/privacy') ? 'page' : undefined}>Privacy Policy</a>
        <a href="/terms/" aria-current={Astro.url.pathname.startsWith('/terms') ? 'page' : undefined}>Terms of Service</a>
      </nav>
      <header class="legal-heading">
        <p class="legal-eyebrow">THE DETAILS THAT MATTER</p>
        <h1>{heading}</h1>
        <p class="legal-date">
          Effective <time datetime={effective}>{effectiveLabel}</time>
        </p>
        <div class="legal-intro"><slot name="intro" /></div>
      </header>

      <details class="legal-mobile-toc"><summary>On this page <ChevronDown size={17}/></summary><nav aria-label="Sections">{sections.map(s => <a href={`#${s.id}`}>{s.label}</a>)}</nav></details>
      <div class="legal-columns">
        <nav class="legal-sidebar" aria-labelledby="legal-toc">
          <p id="legal-toc">On this page</p>
          <ol>{sections.map((s, i) => <li><a href={`#${s.id}`}><span>{String(i+1).padStart(2,'0')}</span>{s.label}</a></li>)}</ol>
          <a class="legal-contact" href="#contact">Have a question?<ArrowUpRight size={15}/></a>
        </nav>

        <article class="legal legal-body">
          <slot />
        </article>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  document.querySelectorAll('.legal-mobile-toc a').forEach(a => a.addEventListener('click', () => document.querySelector('.legal-mobile-toc')?.removeAttribute('open')));
</script>
