---
import BaseLayout from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { DOWNLOAD_URL, SITE } from '../config/site';

const downloadLabel = DOWNLOAD_URL ? 'Download for Windows' : 'Get Intent for Windows';
const downloadHref = DOWNLOAD_URL ?? '#download';

// Truthful properties only: no ratings, prices, download counts or release dates
// until they exist. `downloadUrl` appears once a real installer is published.
const structuredData = [
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: `${SITE.url}/`,
    logo: `${SITE.url}/icon-512.png`,
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
    inLanguage: 'en',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': `${SITE.url}/#software`,
    name: SITE.name,
    description:
      'Intent is a Windows desktop app that links monthly goals to daily tasks, runs focus sessions on one current task, helps you return after distractions, and closes each day with a short reflection and weekly and monthly reviews.',
    url: `${SITE.url}/`,
    applicationCategory: 'ProductivityApplication',
    operatingSystem: SITE.os,
    image: `${SITE.url}${SITE.ogImage}`,
    publisher: { '@id': `${SITE.url}/#organization` },
    featureList: [
      'Monthly goals with measurable targets',
      'Daily task planning linked to monthly goals',
      'One current mission at a time',
      'Focus sessions of 15, 25, 45 or 60 minutes, custom or open-ended',
      'Distraction recovery and away-time prompts',
      'Kero, an always-on-top pixel-art desktop companion',
      'Daily reflection',
      'Weekly and monthly reviews',
    ],
    ...(DOWNLOAD_URL ? { downloadUrl: DOWNLOAD_URL } : {}),
  },
];
---

<BaseLayout structuredData={structuredData}>
<SiteHeader />

<main id="main">

<!-- ═══════════════════════════ HERO ═══════════════════════════ -->
<section class="relative pt-14 pb-20 md:pt-24 md:pb-28 overflow-hidden border-b border-hairline" aria-labelledby="hero-title">
  <div class="absolute inset-0 bg-grid-pattern pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] max-w-full h-[350px] bg-focus/10 blur-[130px] rounded-full pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-1/3 left-1/3 -translate-x-1/2 w-[350px] h-[250px] bg-recovery/5 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <h1 id="hero-title" class="font-heading text-white">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-mid/80 border border-focus/30 text-focus-soft text-xs font-mono font-medium tracking-[0.06em] uppercase mb-7">
        <span class="w-2 h-2 rounded-full bg-focus-soft motion-safe:animate-pulse" aria-hidden="true"></span>
        Intent · A focus app for Windows
      </span>{" "}
      <span class="block text-display-xl font-extrabold text-balance max-w-5xl mx-auto">
        Your goals shouldn't disappear <br class="hidden sm:inline" />
        when you <span class="text-transparent bg-clip-text bg-gradient-to-r from-focus-soft via-focus-soft to-recovery-soft">get distracted<span class="kern-punct">.</span></span>
      </span>
    </h1>

    <p class="text-lg sm:text-xl text-fg-muted max-w-2xl mx-auto leading-[1.6] tracking-[-0.011em] mt-6 mb-10 text-pretty">
      <span class="text-white font-medium">Intent</span> links your monthly goals to today's tasks, keeps one current mission in front of you, and helps you <span class="text-recovery-soft font-medium">get back to work</span> after an interruption. No streaks to break, no alarms, no guilt.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-6">
      <a class="press w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-lg bg-focus hover:bg-focus-soft text-[#0c0e14] font-semibold text-[15px] shadow-focus-glow" href={downloadHref}>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801"></path></svg>
        {downloadLabel}
      </a>
      <a class="press w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg bg-[#141822] hover:bg-surface-high text-fg border border-hairline font-medium text-[15px]" href="#returning">
        See how returning works <span aria-hidden="true">↓</span>
      </a>
    </div>

    <p class="text-sm font-mono text-fg-muted mb-14 md:mb-16">
      Windows 10 &amp; 11 <span aria-hidden="true">·</span> Local-first storage <span aria-hidden="true">·</span> Kero desktop companion
    </p>

    <!-- Product showcase: an HTML rendering of Intent's real Today view -->
    <figure class="relative mx-auto max-w-6xl text-left">
      <div role="img" aria-label="Intent's Today view: the current mission, “Graph problems daily”, is paused at 06:19 of 25:00 after the user stepped away. A banner says “Welcome back. Decide how to count the time away whenever you're ready.” and Kero, the companion, asks how to count the time away.">
        <div aria-hidden="true" class="rounded-2xl border border-hairline bg-canvas shadow-window overflow-hidden">
          <!-- Title bar -->
          <div class="h-9 bg-canvas border-b border-hairline px-3.5 flex items-center justify-between select-none">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full bg-focus/60 shrink-0"></span>
              <span class="text-xs font-semibold tracking-wider text-fg">INTENT</span>
              <span class="hidden sm:inline text-xs font-semibold text-fg-muted truncate">: Your Companion for Finally Locking In</span>
              <span class="h-3 w-px bg-hairline shrink-0"></span>
              <span class="flex items-center gap-1.5 rounded bg-surface-low px-1.5 py-0.5 font-mono text-[11px] text-fg-muted shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-recovery"></span>Kero: Paused
              </span>
            </div>
            <div class="flex items-center gap-3 text-fg-subtle">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/></svg>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </div>
          </div>

          <div class="grid grid-cols-12 bg-canvas">
            <!-- Sidebar -->
            <div class="hidden md:flex md:col-span-3 border-r border-hairline bg-surface-low p-4 flex-col justify-between">
              <div>
                <div class="flex items-center gap-2.5 mb-6 px-1">
                  <div class="w-8 h-8 rounded-lg bg-surface-mid border border-hairline flex items-center justify-center text-focus-soft">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M7 20h10"></path><path d="M10 20c5.5-2.5.8-6.4 3-10"></path><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4-.1 5.5.8z"></path><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4.1.9-4.9 2z"></path></svg>
                  </div>
                  <div>
                    <div class="text-sm font-heading font-semibold text-white leading-tight">INTENT</div>
                    <div class="text-[10px] font-mono text-fg-subtle">v0.1 desktop</div>
                  </div>
                </div>
                <div class="space-y-1 text-[13px]">
                  <div class="flex items-center gap-2.5 h-9 px-2.5 rounded-md bg-surface-mid text-focus-soft border-l-2 border-focus font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>Today
                  </div>
                  <div class="flex items-center gap-2.5 h-9 px-2.5 rounded-md text-fg-muted border-l-2 border-transparent">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>Goals
                  </div>
                  <div class="flex items-center gap-2.5 h-9 px-2.5 rounded-md text-fg-muted border-l-2 border-transparent">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>Reviews
                  </div>
                  <div class="flex items-center gap-2.5 h-9 px-2.5 rounded-md text-fg-muted border-l-2 border-transparent">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg>Companion
                  </div>
                  <div class="flex items-center gap-2.5 h-9 px-2.5 rounded-md text-fg-muted border-l-2 border-transparent">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="4" x2="4" y1="21" y2="14"></line><line x1="4" x2="4" y1="10" y2="3"></line><line x1="12" x2="12" y1="21" y2="12"></line><line x1="12" x2="12" y1="8" y2="3"></line><line x1="20" x2="20" y1="21" y2="16"></line><line x1="20" x2="20" y1="12" y2="3"></line><line x1="1" x2="7" y1="14" y2="14"></line><line x1="9" x2="15" y1="8" y2="8"></line><line x1="17" x2="23" y1="16" y2="16"></line></svg>Settings
                  </div>
                </div>
              </div>
              <div class="space-y-2 border-t border-hairline pt-3">
                <div class="flex items-center gap-2.5 rounded-lg border border-hairline bg-surface-mid p-2">
                  <div class="w-9 h-9 shrink-0 rounded-md border border-hairline bg-canvas flex items-center justify-center">
                    <span class="kero" data-kero="paused" style="--kero-size:32px"></span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-semibold text-fg">Kero</span>
                      <span class="text-[10px] font-mono text-recovery">Paused</span>
                    </div>
                    <div class="truncate font-mono text-[11px] text-fg-muted">Welcome back. How should we count the time away?</div>
                  </div>
                </div>
                <div class="flex items-center justify-between h-8 px-2 text-[11px] text-fg-muted">
                  <span>Kero on desktop</span>
                  <span class="font-mono text-[10px] text-focus-soft">ON</span>
                </div>
              </div>
            </div>

            <!-- Today -->
            <div class="col-span-12 md:col-span-9 p-5 md:p-6 bg-canvas">
              <div class="flex items-center gap-2 text-xs font-mono text-focus-soft mb-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
                Thursday, 1 Oct
              </div>
              <div class="text-2xl font-heading font-extrabold text-white tracking-tight mb-5">Today's Focus Deck</div>

              <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                <div class="lg:col-span-7 space-y-4">
                  <!-- Current mission -->
                  <div class="rounded-xl bg-surface-mid border border-hairline p-5 shadow-card">
                    <div class="flex items-center justify-between mb-4">
                      <div class="flex items-center gap-2">
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-focus/10 text-focus-soft border border-focus/30">
                          <span class="w-1.5 h-1.5 rounded-full bg-focus-soft"></span>CURRENT MISSION
                        </span>
                        <span class="px-2 py-0.5 rounded text-[10px] font-mono text-fg-muted bg-surface-high border border-hairline">Done</span>
                      </div>
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-plan/15 text-plan-soft border border-plan/30">DSA</span>
                    </div>
                    <div class="text-xl font-heading font-bold text-white tracking-[-0.012em] mb-5">Graph problems daily</div>
                    <div class="rounded-lg bg-surface-low border border-hairline p-4 mb-4">
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-[10px] font-mono font-semibold tracking-wider text-recovery-soft">WELCOME BACK</span>
                        <span class="text-[10px] font-mono text-fg-muted">Started 10:25 pm</span>
                      </div>
                      <div class="flex items-baseline gap-3 mb-3">
                        <span class="text-3xl sm:text-4xl font-mono font-bold text-white tracking-tight">06:19</span>
                        <span class="text-xs font-mono text-fg-muted">remaining of 25:00</span>
                      </div>
                      <div class="w-full bg-surface-high h-1.5 rounded-full overflow-hidden mb-2">
                        <div class="bg-recovery-soft h-1.5 rounded-full w-[75%]"></div>
                      </div>
                      <div class="text-[10px] font-mono text-fg-muted">18:41 focused so far</div>
                    </div>
                    <div class="rounded-lg bg-surface-low border border-recovery/25 p-4 relative overflow-hidden">
                      <div class="absolute left-0 top-0 bottom-0 w-1 bg-recovery-soft"></div>
                      <p class="text-xs text-fg-muted mb-3 pl-1 leading-relaxed">Welcome back. Decide how to count the time away whenever you're ready.</p>
                      <span class="inline-block ml-1 px-3 py-1.5 rounded-md bg-focus text-[#0c0e14] text-xs font-medium">Review time away</span>
                    </div>
                  </div>
                </div>

                <div class="lg:col-span-5 space-y-4">
                  <div class="rounded-xl bg-surface-mid border border-hairline p-4 shadow-card">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-xs font-heading font-bold text-white tracking-wide">Today's Focus List</span>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-focus/10 text-focus-soft border border-focus/20">1 / 3 done</span>
                    </div>
                    <p class="text-[11px] text-fg-muted mb-3 leading-normal">Tasks planned for today. Use the target icon to make one your mission.</p>
                    <ul class="space-y-1.5 mb-3 text-xs">
                      <li class="flex items-center gap-2 rounded-md bg-surface-low border border-focus/30 px-2.5 py-2 text-fg"><span class="w-3 h-3 rounded-full border border-focus-soft shrink-0"></span>Graph problems daily<span class="ml-auto text-[10px] font-mono text-plan-soft">DSA</span></li>
                      <li class="flex items-center gap-2 rounded-md bg-surface-low border border-hairline px-2.5 py-2 text-fg-muted line-through decoration-fg-subtle"><span class="w-3 h-3 rounded-full bg-focus-soft shrink-0"></span>Review lecture notes</li>
                      <li class="flex items-center gap-2 rounded-md bg-surface-low border border-hairline px-2.5 py-2 text-fg"><span class="w-3 h-3 rounded-full border border-hairline-strong shrink-0"></span>Email project mentor<span class="ml-auto text-[10px] font-mono text-fg-subtle">15m</span></li>
                    </ul>
                    <div class="flex items-center rounded-md bg-surface-low border border-hairline px-3 py-1.5">
                      <span class="text-fg-subtle text-xs mr-2">+</span>
                      <span class="w-full text-xs text-fg-subtle">Add a task for today…</span>
                      <span class="text-[10px] font-mono bg-surface-high text-fg-muted px-1.5 py-0.5 rounded border border-hairline">Enter</span>
                    </div>
                  </div>

                  <div class="rounded-xl bg-surface-mid border border-hairline p-4 shadow-card">
                    <div class="flex items-center justify-between mb-3">
                      <span class="text-xs font-heading font-bold text-white tracking-wide">Daily Pulse</span>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-recovery/10 text-recovery-soft border border-recovery/20">Paused</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2 text-center mb-2">
                      <div class="bg-surface-low border border-hairline p-2.5 rounded-lg"><span class="text-[10px] font-mono text-fg-muted block mb-1">FOCUSED</span><span class="text-base font-mono font-bold text-white">44m</span></div>
                      <div class="bg-surface-low border border-hairline p-2.5 rounded-lg"><span class="text-[10px] font-mono text-fg-muted block mb-1">SESSIONS</span><span class="text-base font-mono font-bold text-white">1</span></div>
                      <div class="bg-surface-low border border-hairline p-2.5 rounded-lg"><span class="text-[10px] font-mono text-fg-muted block mb-1">TASKS</span><span class="text-base font-mono font-bold text-white">1/3</span></div>
                    </div>
                    <div class="text-[10px] font-mono text-fg-muted text-right">Includes the live session</div>
                  </div>

                  <div class="rounded-xl bg-surface-mid border border-hairline p-4 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-lg bg-recovery-soft/10 border border-recovery-soft/20 flex items-center justify-center text-recovery-soft">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                      </div>
                      <div>
                        <div class="text-xs font-heading font-bold text-white">Day Wrap &amp; Reflect</div>
                        <div class="text-[11px] text-fg-muted">Wrap up your day in 2 minutes when you're done.</div>
                      </div>
                    </div>
                    <span class="text-fg-subtle text-xs">→</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="mt-4 text-center text-sm text-fg-muted">The Today view in Intent v0.1, mid-session, right after stepping away.</figcaption>
    </figure>
  </div>
</section>

<!-- ═══════════════════════════ WHY ═══════════════════════════ -->
<section class="section border-b border-hairline" id="why" aria-labelledby="why-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionIntro eyebrow="The fundamental shift" headingId="why-title">
      <Fragment slot="title">Most focus apps assume you won't get distracted. Intent assumes you will.</Fragment>
      Many productivity tools treat attention like an assembly line. When an interruption arrives, and it always does, they answer with broken streaks and red “failed” states. That's usually when people quietly stop using them.
    </SectionIntro>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-10" data-reveal-group>
      <div class="rounded-2xl bg-surface-low border border-danger/20 p-7 md:p-8">
        <p class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-danger/10 border border-danger/20 text-danger text-xs font-mono mb-5">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          THE USUAL APPROACH
        </p>
        <h3 class="text-xl md:text-2xl font-heading font-bold text-white tracking-[-0.014em] mb-4">Perfection, or nothing</h3>
        <ul class="space-y-3.5 text-base text-fg-muted">
          <li class="flex gap-3"><span class="text-danger font-mono shrink-0" aria-hidden="true">―</span><span>Streaks that reset to zero the first time Slack needs you.</span></li>
          <li class="flex gap-3"><span class="text-danger font-mono shrink-0" aria-hidden="true">―</span><span>Red warnings and broken-streak animations for being human.</span></li>
          <li class="flex gap-3"><span class="text-danger font-mono shrink-0" aria-hidden="true">―</span><span>Endless backlogs with no link to what this month is actually about.</span></li>
          <li class="flex gap-3"><span class="text-danger font-mono shrink-0" aria-hidden="true">―</span><span>Miss a few days and the whole system gets abandoned.</span></li>
        </ul>
      </div>
      <div class="rounded-2xl bg-surface-low border border-focus/30 p-7 md:p-8 shadow-focus-glow">
        <p class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-focus/10 border border-focus/30 text-focus-soft text-xs font-mono mb-5">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          HOW INTENT WORKS
        </p>
        <h3 class="text-xl md:text-2xl font-heading font-bold text-white tracking-[-0.014em] mb-4">Returning is the skill</h3>
        <ul class="space-y-3.5 text-base text-fg-muted">
          <li class="flex gap-3"><span class="text-focus-soft font-mono shrink-0" aria-hidden="true">―</span><span>“I got distracted” is a first-class button with a one-tap way back.</span></li>
          <li class="flex gap-3"><span class="text-focus-soft font-mono shrink-0" aria-hidden="true">―</span><span>Time away is yours to classify as focus, a break or a distraction. It's never a failure.</span></li>
          <li class="flex gap-3"><span class="text-focus-soft font-mono shrink-0" aria-hidden="true">―</span><span>Tasks link to monthly goals, so today's work connects to the bigger picture.</span></li>
          <li class="flex gap-3"><span class="text-focus-soft font-mono shrink-0" aria-hidden="true">―</span><span>Unfinished work is “not done yet” or “moved”, never “failed”.</span></li>
        </ul>
      </div>
    </div>

    <figure class="rounded-2xl bg-[#11141d] border border-hairline px-6 py-10 md:p-12 text-center" data-reveal>
      <blockquote class="max-w-3xl mx-auto">
        <p class="text-display-md font-heading font-bold text-white tracking-[-0.014em] text-balance">
          “Getting distracted is expected<span class="kern-punct">.</span> <br class="hidden sm:inline" />
          <span class="text-recovery-soft">Returning</span> is the skill<span class="kern-punct">.</span>”
        </p>
