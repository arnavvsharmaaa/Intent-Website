---
import Base from '../layouts/Base.astro';
import Header from '../components/SiteHeader.astro';
import Footer from '../components/SiteFooter.astro';
import { ArrowDown, ArrowUpRight, ListChecks, Focus, CornerUpLeft, RotateCcw, Film, Check, Plus } from 'lucide-astro';
import { SITE, DOWNLOAD_URL } from '../config/site';
import '../styles/home.css';
const video = import.meta.env.PUBLIC_DEMO_VIDEO_URL?.trim();
const structuredData = [{ '@type': 'SoftwareApplication', name: SITE.name, operatingSystem: SITE.os, applicationCategory: 'ProductivityApplication', description: SITE.description, url: SITE.url, ...(DOWNLOAD_URL ? { downloadUrl: DOWNLOAD_URL } : {}) }];
const faqs = [
  ['What is Intent?', 'Intent is a focus and goal-planning app for Windows. Connect monthly goals to daily tasks, work on one thing at a time, and return after interruptions.'],
  ['Which computers does it support?', 'Intent is built for Windows 10 (22H2 or later) and Windows 11.'],
  ['What happens when I get distracted?', 'Your task stays right where you left it. Pause, take a break, or return to your focus session when you are ready.'],
  ['Who is Kero?', 'Kero is your optional desktop companion. It reflects your focus session and keeps your current task in view. You can resize, snooze, or hide it.'],
  ['Where is my task data stored?', 'Intent uses local-first storage on your computer. Read the privacy policy for the full details.'],
  ['Can I download Intent now?', DOWNLOAD_URL ? 'Yes. Use Download for Windows to get the installer.' : 'The Windows installer is coming soon. The download will be available here when it is ready.'],
];
---
<Base title="Intent | Focus & Goal Planning App for Windows" structuredData={structuredData}>
<Header />
<main id="main" class="intent-home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="overline"><span class="status-dot"></span>A LITTLE FOCUS. A FRESH START.</p><h1 id="hero-title">Intent<span class="hero-subtitle">Your focus app for Windows.</span></h1><p class="hero-description">One task at a time. A calmer way back when life interrupts.</p><div class="actions"><a class="button primary" href={DOWNLOAD_URL ?? '#download'}>{DOWNLOAD_URL ? 'Download for Windows' : 'Coming soon for Windows'}<ArrowUpRight size={18}/></a><a class="text-link" href="#demo">See Intent in action<ArrowDown size={16}/></a></div></div>
    <div class="kero-world" id="kero-world" role="img" aria-label="Interactive three-dimensional Kero companion"><div class="scene-fallback" id="scene-fallback"><div class="fallback-kero"></div></div></div>
    <div class="scene-caption"><span class="status-dot"></span><span id="kero-message" aria-live="polite">A little company for your focus time.</span></div>
    <div class="scene-controls" role="group" aria-label="Kero session state">{['Focus', 'Pause', 'Break', 'Snooze'].map((state, i) => <button type="button" data-state={state.toLowerCase()} aria-pressed={i === 0}>{state}</button>)}<button class="reset-scene" id="reset-scene" type="button" title="Reset Kero view" aria-label="Reset Kero view"><RotateCcw size={16}/></button></div>
    <div class="hero-foot"><span>MEET KERO. YOUR DESKTOP COMPANION.</span><a href="#features">Less pressure. More progress.<ArrowDown size={15}/></a></div>
  </section>
  <section id="features" class="benefits light-section"><div class="section-heading"><p class="overline">ROOM TO FOCUS</p><h2>Big goals.<br/><span>Small, doable steps.</span></h2><p>A simple rhythm for work, study, and everything you want to move forward.</p></div><div class="benefit-grid">
    <article tabindex="0" aria-label="Plan: choose what matters"><span class="feature-icon"><ListChecks size={26} strokeWidth={1.6}/></span><span class="step">01 / PLAN</span><h3>Choose what matters.</h3><p>Connect today's tasks to your monthly goals. Give your day a clear starting point.</p></article>
    <article tabindex="0" aria-label="Focus: make space for one thing"><span class="feature-icon"><Focus size={26} strokeWidth={1.6}/></span><span class="step">02 / FOCUS</span><h3>Make space for one thing.</h3><p>Pick a task and start a focus session. Kero keeps you company while you work.</p></article>
    <article tabindex="0" aria-label="Return: start again guilt-free"><span class="feature-icon"><CornerUpLeft size={26} strokeWidth={1.6}/></span><span class="step">03 / RETURN</span><h3>Start again. Guilt-free.</h3><p>Got distracted? Your progress is still here. Take a breath and pick up where you left off.</p></article>
  </div></section>
  <section id="demo" class="demo-section light-section"><div class="demo-heading"><div><p class="overline">THE APP, IN ACTION</p><h2>A little less explaining.<br/>A little more showing.</h2></div><p>From your first task to your next fresh start.</p></div>{video ? <video class="demo-video" controls preload="metadata" playsinline aria-label="Intent app walkthrough"><source src={video}/>Your browser does not support video playback.</video> : <div class="video-placeholder"><Film size={38} strokeWidth={1.3}/><h3>Meet your new focus routine.</h3><p>App walkthrough coming soon.</p><span class="video-label">INTENT / PRODUCT FILM</span></div>}</section>
  <section id="faq" class="faq-section light-section"><div><p class="overline">GOOD TO KNOW</p><h2>A few answers.<br/>Then, back to you.</h2></div><div class="faq-list">{faqs.map(([q,a]) => <details><summary>{q}<Plus size={18}/></summary><p>{a}</p></details>)}</div></section>
  <section id="download" class="download-section"><p class="overline">YOUR NEXT FRESH START</p><h2>Getting distracted is expected.<br/><span>Returning is the skill.</span></h2><p>{DOWNLOAD_URL ? 'Make room for what matters with Intent for Windows.' : 'Intent is growing. The Windows installer is coming soon.'}</p>{DOWNLOAD_URL && <a class="button primary" href={DOWNLOAD_URL}>Download for Windows<ArrowUpRight size={18}/></a>}<div class="download-notes"><span><Check size={15}/>Windows 10 & 11</span><span><Check size={15}/>Local-first storage</span><span><Check size={15}/>Kero included</span></div></section>
</main><Footer /><script>import '../scripts/kero-scene';</script>
</Base>
