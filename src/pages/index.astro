<script>
  import { clips as keroClips } from '../data/kero-manifest.json';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T | null;
  const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll(sel)) as T[];

  /* ── Reveal on scroll (groups stagger their children) ── */
  $$('[data-reveal-group]').forEach((group) => {
    Array.from(group.children).forEach((child, i) => {
      const el = child as HTMLElement;
      el.setAttribute('data-reveal', '');
      el.style.setProperty('--i', String(i));
    });
  });
  const revealIO = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const t = e.target as HTMLElement;
      t.classList.add('is-in');
      t.querySelectorAll('[data-fill]').forEach((f) => f.classList.add('is-in'));
      revealIO.unobserve(t);
      // Once settled, hand the element back to its own hover/press transitions.
      const settle = (ev: TransitionEvent) => {
        if (ev.target !== t || ev.propertyName !== 'opacity') return;
        t.removeEventListener('transitionend', settle);
        t.removeAttribute('data-reveal'); t.classList.remove('is-in'); t.style.removeProperty('--i');
      };
      t.addEventListener('transitionend', settle);
    }
  }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
  $$('[data-reveal]').forEach((el) => revealIO.observe(el));

  /* ── Kero: plays clips straight from the companion pack manifest ── */
  type Clip = { frames: number[]; durationsMs: number[]; loop: string };
  const clips = keroClips as Record<string, Clip>;
  const players = new WeakMap<HTMLElement, { timer?: number }>();
  const showFrame = (el: HTMLElement, f: number) => {
    el.style.setProperty('--col', String(f % 8));
    el.style.setProperty('--row', String(Math.floor(f / 8)));
  };
  const play = (el: HTMLElement, name: string, onDone?: () => void) => {
    const st = players.get(el) ?? {};
    window.clearTimeout(st.timer);
    players.set(el, st);
    const clip = clips[name];
    if (!clip) return;
    if (reduceMotion.matches) {           // one calm, representative pose — no looping
      showFrame(el, clip.frames[0]);
      if (onDone) st.timer = window.setTimeout(onDone, 600);
      return;
    }
    let i = 0;
    const step = () => {
      showFrame(el, clip.frames[i]);
      const d = clip.durationsMs[i];
      i++;
      if (i >= clip.frames.length) {
        if (clip.loop === 'loop') i = 0;
        else { st.timer = window.setTimeout(() => onDone?.(), d); return; }
      }
      st.timer = window.setTimeout(step, d);
    };
    step();
  };
  const clipFor: Record<string, string> = { focusing: 'focusing', paused: 'paused', break: 'break', sleep: 'sleep', idle: 'idle' };

  // Only animate sprites that are on screen; off-screen ones hold their first frame.
  const spriteIO = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const el = e.target as HTMLElement;
      if (e.isIntersecting) play(el, clipFor[el.dataset.kero!] ?? el.dataset.kero!);
      else window.clearTimeout(players.get(el)?.timer);
    }
  });
  $$('.kero[data-kero]').forEach((el) => {
    showFrame(el, clips[clipFor[el.dataset.kero!]]?.frames[0] ?? 0);
    if (el.id !== 'kero-big' && el.id !== 'pad-kero') spriteIO.observe(el);
  });

  /* ── Companion stage: segmented states + press-and-hold ── */
  const big = $('#kero-big');
  const stage = $<HTMLButtonElement>('#kero-stage');
  const caption = $('#kero-caption');
  const thumb = $('#kero-thumb');
  const segBtns = $$<HTMLButtonElement>('[data-kero-state]');
  let keroState = 'focusing';
  const labels: Record<string, string> = { focusing: 'FOCUSING', paused: 'PAUSED', break: 'ON A BREAK', sleep: 'SNOOZED' };
  const spoken: Record<string, string> = { focusing: 'focusing', paused: 'paused', break: 'on a break', sleep: 'snoozed' };
  const setKero = (state: string) => {
    keroState = state;
    segBtns.forEach((b, i) => {
      const on = b.dataset.keroState === state;
      b.setAttribute('aria-checked', String(on));
      b.tabIndex = on ? 0 : -1;
      b.classList.toggle('text-fg', on);
      b.classList.toggle('text-fg-muted', !on);
      if (on && thumb) thumb.style.transform = `translateX(${i * 100}%)`;
    });
    if (caption) caption.textContent = labels[state];
    big?.setAttribute('aria-label', `Kero the frog, ${spoken[state]}`);
    if (big) play(big, clipFor[state]);
  };
  segBtns.forEach((b) => {
    b.addEventListener('click', () => setKero(b.dataset.keroState!));
    b.addEventListener('keydown', (e) => {
      const i = segBtns.indexOf(b);
      const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const next = segBtns[(i + dir + segBtns.length) % segBtns.length];
      next.focus(); setKero(next.dataset.keroState!);
    });
  });
  // The big sprite and the pad sprite only animate while visible.
  if (big) new IntersectionObserver(([e]) => { if (e.isIntersecting) play(big, clipFor[keroState]); else window.clearTimeout(players.get(big)?.timer); }).observe(big);

  // Pick up on press (instant), celebrate on release, then settle back into the session state.
  let holding = false;
  const pickUp = () => {
    if (!big || holding) return;
    holding = true;
    big.style.transition = 'transform 220ms cubic-bezier(0.22, 1, 0.36, 1)';
    if (!reduceMotion.matches) big.style.transform = 'translateY(-10px)';
    if (caption) caption.textContent = 'HELD';
    play(big, 'held');
  };
  const putDown = (celebrate: boolean) => {
    if (!big || !holding) return;
    holding = false;
    big.style.transform = '';
    if (!celebrate) return setKero(keroState);
    if (caption) caption.textContent = 'HAPPY';
    play(big, 'celebrate', () => setKero(keroState));
  };
  stage?.addEventListener('pointerdown', (e) => { stage.setPointerCapture(e.pointerId); pickUp(); });
  stage?.addEventListener('pointerup', () => putDown(true));
  stage?.addEventListener('pointercancel', () => putDown(false));
  stage?.addEventListener('keydown', (e) => { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) { e.preventDefault(); pickUp(); } });
  stage?.addEventListener('keyup', (e) => { if (e.key === ' ' || e.key === 'Enter') putDown(true); });
  stage?.addEventListener('blur', () => putDown(false));
  stage?.addEventListener('contextmenu', (e) => e.preventDefault());

  /* ── Return demo: a tiny, live version of the real away prompt ── */
  const pad = $('#return-pad');
  if (pad) {
    const el = {
      status: $('#pad-status')!, meta: $('#pad-meta')!, timer: $('#pad-timer')!, timerLabel: $('#pad-timer-label')!,
      bar: $('#pad-bar')!, footL: $('#pad-foot-l')!, footR: $('#pad-foot-r')!, line: $('#pad-line')!,
      kero: $('#pad-kero')!, choices: $('#pad-choices')!, after: $('#pad-after')!,
    };
    const fmt = (sec: number) => `${String(Math.floor(sec / 60)).padStart(2, '0')}:${String(sec % 60).padStart(2, '0')}`;
    // A 45-minute session, 18:41 focused, then 14m 20s away.
    const SESSION = 45 * 60, FOCUSED = 18 * 60 + 41, AWAY = 14 * 60 + 20, BREAK = 5 * 60;
    let tick: number | undefined;
    const pending = new WeakMap<HTMLElement, number>();
    // Cross-fade text; if a new state arrives mid-swap, the newest text wins immediately.
    const swap = (node: HTMLElement, text: string) => {
      if (node.textContent?.trim() === text) return;
      window.clearTimeout(pending.get(node));
      if (!node.classList.contains('pad-swap') || reduceMotion.matches) { node.textContent = text; return; }
      node.setAttribute('data-leaving', '');
      pending.set(node, window.setTimeout(() => { node.textContent = text; node.removeAttribute('data-leaving'); }, 140));
    };
    const bar = (v: number) => { el.bar.style.transform = `scaleX(${Math.max(0, Math.min(1, v))})`; };
    const runFocus = (focused: number) => {
      const render = () => { el.timer.textContent = fmt(SESSION - focused); bar(focused / SESSION); el.footR.textContent = `${fmt(focused)} focused`; };
      render();
      tick = window.setInterval(() => { focused = Math.min(SESSION, focused + 1); render(); }, 1000);
    };

    const states: Record<string, () => void> = {
      paused() {
        swap(el.status, 'WELCOME BACK'); swap(el.meta, 'Away for 14m 20s');
        el.timer.textContent = fmt(SESSION - FOCUSED); swap(el.timerLabel, 'paused · of 45:00'); bar(FOCUSED / SESSION);
        swap(el.footL, 'Paused while you were away'); el.footR.textContent = `${fmt(FOCUSED)} focused`;
        swap(el.line, '“Welcome back. How should we count the time away?”');
        el.kero.setAttribute('aria-label', 'Kero, paused');
      },
      focus() {
        swap(el.status, 'COUNTED AS FOCUS'); swap(el.meta, '+14m 20s added');
        swap(el.timerLabel, 'remaining of 45:00'); swap(el.footL, 'Same task, same place');
        swap(el.line, '“Still with it. Keep going.”');
        el.kero.setAttribute('aria-label', 'Kero, focusing');
        runFocus(FOCUSED + AWAY);
      },
      break() {
        swap(el.status, 'ON A BREAK'); swap(el.meta, 'Not counted as focus');
        swap(el.timerLabel, 'of 5:00 break'); swap(el.footL, 'Your focus so far is saved'); el.footR.textContent = `${fmt(FOCUSED)} focused`;
        swap(el.line, '“On a break. Come back whenever you’re ready.”');
        el.kero.setAttribute('aria-label', 'Kero, on a break');
        let left = BREAK;
        const render = () => { el.timer.textContent = fmt(left); bar(left / BREAK); };
        render();
        tick = window.setInterval(() => { left = Math.max(0, left - 1); render(); }, 1000);
      },
      distracted() {
        swap(el.status, 'LOGGED AS A RETURN'); swap(el.meta, 'Back on task');
        swap(el.timerLabel, 'remaining of 45:00'); swap(el.footL, 'Return recorded for your review');
        swap(el.line, '“Welcome back. Returning is the skill.”');
        el.kero.setAttribute('aria-label', 'Kero, encouraging');
        runFocus(FOCUSED);
      },
    };

    const setPad = (state: string, fromKeyboard = false) => {
      window.clearInterval(tick);
      pad.setAttribute('data-state', state);
      states[state]?.();
      if (state === 'distracted') play(el.kero, 'encourage', () => { if (pad.dataset.state === 'distracted') play(el.kero, 'focusing'); });
      else play(el.kero, state === 'focus' ? 'focusing' : clipFor[state]);
      const done = state !== 'paused';
      const hadFocus = el.choices.contains(document.activeElement) || el.after.contains(document.activeElement);
      el.choices.classList.toggle('hidden', done); el.choices.classList.toggle('grid', !done);
      el.after.classList.toggle('hidden', !done); el.after.classList.toggle('flex', done);
      if (hadFocus || fromKeyboard) (done ? $('button', el.after) : $('button', el.choices))?.focus({ preventScroll: true });
    };
    $$<HTMLButtonElement>('[data-action]', pad).forEach((b) =>
      b.addEventListener('click', (e) => setPad(b.dataset.action!, (e as MouseEvent).detail === 0)),
    );
    // Animate the pad's Kero only while the demo is on screen.
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { const s = pad.dataset.state!; play(el.kero, s === 'focus' || s === 'distracted' ? 'focusing' : clipFor[s]); }
      else window.clearTimeout(players.get(el.kero)?.timer);
    }).observe(pad);
  }
</script>
</BaseLayout>
