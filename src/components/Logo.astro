---
// Intent's sprout mark, as used in the desktop app's sidebar.
interface Props { class?: string }
const { class: cls = 'w-8 h-8' } = Astro.props;
---
<span class:list={['rounded-lg bg-focus/15 border border-focus/30 inline-flex items-center justify-center text-focus-soft shrink-0', cls]} aria-hidden="true">
  <svg class="w-1/2 h-1/2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24">
    <path d="M7 20h10"></path>
    <path d="M10 20c5.5-2.5.8-6.4 3-10"></path>
    <path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4-.1 5.5.8z"></path>
    <path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4.1.9-4.9 2z"></path>
  </svg>
</span>
