---
import { DOWNLOAD_URL } from '../config/site';
import { ArrowUpRight, Menu } from 'lucide-astro';
import '../styles/home.css';
---
<header class="simple-header"><a class="brand" href="/" aria-label="Intent home"><span class="brand-mark" aria-hidden="true">i</span>intent</a><nav class="desktop-nav" aria-label="Main"><a href="/#features">Features</a><a href="/#demo">See it in action</a><a href="/#faq">FAQs</a></nav><a class="header-cta" href={DOWNLOAD_URL ?? '/#download'}>{DOWNLOAD_URL ? 'Download' : 'Coming soon'}<ArrowUpRight size={16}/></a><details class="mobile-nav"><summary aria-label="Open navigation"><Menu size={23}/></summary><nav aria-label="Mobile"><a href="/#features">Features</a><a href="/#demo">See it in action</a><a href="/#faq">FAQs</a></nav></details></header>
<script>document.querySelectorAll('.mobile-nav a').forEach(a => a.addEventListener('click', () => document.querySelector('.mobile-nav')?.removeAttribute('open')));</script>
