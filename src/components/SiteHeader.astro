---
import { DOWNLOAD_URL, SITE } from '../config/site';
import Logo from './Logo.astro';

// Root-relative anchors so the same header works on future pages.
const links = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#returning', label: 'Returning' },
  { href: '/#planning', label: 'Goals' },
  { href: '/#kero', label: 'Kero' },
  { href: '/#reflection', label: 'Reflection' },
  { href: '/#principles', label: 'Principles' },
];
const downloadHref = DOWNLOAD_URL ?? '/#download';
const downloadLabel = DOWNLOAD_URL ? 'Download' : 'Get Intent';
---

<header class="chrome sticky top-0 z-50 w-full" id="site-header" data-scrolled="false">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <a href="/" class="press flex items-center gap-3 rounded-lg" aria-label={`${SITE.name} home`}>
      <Logo class="w-8 h-8" />
      <span class="font-heading font-extrabold text-[17px] tracking-[0.08em] text-white" aria-hidden="true">INTENT</span>
      <span class="hidden sm:inline text-[11px] font-mono font-medium px-1.5 py-0.5 rounded bg-surface-high text-focus-soft border border-focus/20" aria-hidden="true">v{SITE.version}</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="relative flex items-center gap-7 text-sm font-medium text-fg-muted" id="nav-track">
        {links.map((l) => <li><a class="nav-link hover:text-fg" href={l.href}>{l.label}</a></li>)}
        <li class="nav-indicator" aria-hidden="true"></li>
      </ul>
    </nav>

    <div class="flex items-center gap-2.5">
      <span class="hidden xl:inline-flex items-center gap-1.5 text-xs font-mono text-fg-muted px-2.5 py-1 rounded-md border border-hairline">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801"></path></svg>
        Windows 10 &amp; 11
      </span>
      <a class="press inline-flex items-center gap-1.5 bg-focus hover:bg-focus-soft text-[#0c0e14] px-3.5 py-2 rounded-lg text-sm font-semibold tracking-tight" href={downloadHref}>
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"></path></svg>
        {downloadLabel}
      </a>
      <button class="press lg:hidden w-11 h-11 -mr-2 inline-flex items-center justify-center rounded-lg text-fg-muted hover:text-fg hover:bg-surface-mid" type="button" id="menu-button" aria-expanded="false" aria-controls="menu-sheet" aria-label="Open menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" id="menu-icon"></path></svg>
      </button>
    </div>
  </div>

  <div class="menu-sheet lg:hidden absolute right-3 top-[3.75rem] w-[min(18rem,calc(100vw-1.5rem))] rounded-2xl border border-hairline-strong/70 bg-surface-low p-2 shadow-pop" id="menu-sheet" data-open="false">
    <nav aria-label="Mobile">
      <ul class="flex flex-col text-base font-medium text-fg">
        {links.map((l) => <li><a class="press block rounded-xl px-3.5 py-3 hover:bg-surface-mid" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<script>
  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T | null;
  const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll(sel)) as T[];

  /* Header material: show the edge only once content is underneath */
  const header = $('#site-header');
  const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 4));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* Wayfinding: highlight the section you're in (no-op on pages without these sections) */
  const indicator = $('.nav-indicator');
  const navLinks = $$<HTMLAnchorElement>('.nav-link');
  const idOf = (a: HTMLAnchorElement) => (new URL(a.href).pathname === location.pathname ? new URL(a.href).hash.slice(1) : '');
  const setActive = (id: string | null) => {
    let active: HTMLAnchorElement | null = null;
    navLinks.forEach((a) => {
      const on = !!id && idOf(a) === id;
      if (on) { a.setAttribute('aria-current', 'location'); active = a; }
      else a.removeAttribute('aria-current');
    });
    if (!indicator) return;
    if (active) {
      const a = active as HTMLAnchorElement;
      const li = a.parentElement as HTMLElement;
      indicator.style.width = `${a.offsetWidth}px`;
      indicator.style.transform = `translateX(${li.offsetLeft}px)`;
      indicator.style.opacity = '1';
    } else {
      indicator.style.opacity = '0';
    }
  };
  const sections = navLinks.map((a) => (idOf(a) ? document.getElementById(idOf(a)) : null)).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    const visible = new Map<string, number>();
    const navIO = new IntersectionObserver((entries) => {
      for (const e of entries) visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0);
      let best: string | null = null, bestRatio = 0;
      visible.forEach((r, id) => { if (r > bestRatio) { bestRatio = r; best = id; } });
      setActive(best);
    }, { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.01, 0.5, 1] });
    sections.forEach((s) => navIO.observe(s));
  }

  /* Mobile menu: anchored to its trigger, dismissible every way */
  const menuBtn = $<HTMLButtonElement>('#menu-button');
  const sheet = $('#menu-sheet');
  const menuIcon = $('#menu-icon');
  const isOpen = () => sheet?.getAttribute('data-open') === 'true';
  const setMenu = (open: boolean, returnFocus = false) => {
    if (!menuBtn || !sheet) return;
    sheet.setAttribute('data-open', String(open));
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menuIcon?.setAttribute('d', open ? 'M6 6l12 12M18 6L6 18' : 'M4 7h16M4 12h16M4 17h16');
    if (open) $<HTMLElement>('a', sheet)?.focus({ preventScroll: true });
    else if (returnFocus) menuBtn.focus();
  };
  menuBtn?.addEventListener('click', () => setMenu(!isOpen()));
  sheet?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setMenu(false); });
  sheet?.addEventListener('focusout', (e) => {
    const next = (e as FocusEvent).relatedTarget as Node | null;
    if (isOpen() && next && !sheet.contains(next) && next !== menuBtn) setMenu(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) setMenu(false, true); });
  document.addEventListener('pointerdown', (e) => {
    if (isOpen() && !sheet!.contains(e.target as Node) && !menuBtn?.contains(e.target as Node)) setMenu(false);
  });
</script>
