# All variables are optional. The site builds and renders without any of them.

# Direct link to the signed Windows installer (e.g. on releases.intentapp.app).
# When unset, "Download for Windows" buttons lead to the download section,
# which explains that the installer isn't published yet.
PUBLIC_DOWNLOAD_URL=

# Reserved for later. Nothing on the marketing site calls the API today.
PUBLIC_API_BASE_URL=

# App walkthrough video URL or public path such as /videos/intent-demo.mp4.
PUBLIC_DEMO_VIDEO_URL=
